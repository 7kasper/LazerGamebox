	(text "AUDIO: DAC or radio audio -> class-D amp -> speaker; DAC -> radio mic; radio audio -> ADC for DTMF"
		(exclude_from_sim no)
		(at 14 13.2 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "fce30bab-7420-4ea5-9a73-c626dbe3ad54")
	)
	(text "NS4150B gain = 2 x 240k / 220k = 2.2. MUX_SEL low = ESP32 DAC to the speaker, high = radio receive audio to the speaker."
		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "41234c1f-80ff-4a1b-badc-cbf7aeedc78d")
	)
	(text "SOURCE SELECT (TS5A3159)"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b9fc438c-0443-4597-ac81-8811a6554e22")
	)
	(text "DAC1 is 0-3.3 V unipolar; R501 limits current into the switch.\nAC coupling after the switch (C501)."
		(exclude_from_sim no)
		(at 14 92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fd5c7f4f-438c-4865-897a-c7e23c85a45a")
	)
	(text "CLASS-D AMPLIFIER (NS4150B) + 30 mm SPEAKER"
		(exclude_from_sim no)
		(at 159.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f933cd20-7b5e-46bb-9b51-55871a345232")
	)
	(text "R504 keeps the amp off until firmware drives AMP_SD high; R511 limits the current into CTRL while VBAT_SW is off.\nFirmware: AUX_EN high a few ms before AMP_SD high, AMP_SD low before AUX_EN low."
		(exclude_from_sim no)
		(at 250 76 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "404448e0-772c-4c87-9776-fec642a01524")
	)
	(text "Filter-free BTL output: keep speaker traces short and away from the radio. VCC on VBAT_SW with 470 uF bulk.\nMax output about 1 W into 8 ohm at 3.7 V."
		(exclude_from_sim no)
		(at 160 97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "775d1101-6d23-4ff2-b870-0e83759849b1")
	)
	(text "DAC -> RADIO MIC_IN (100:1)"
		(exclude_from_sim no)
		(at 13.5 114 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "3964614e-4a8e-424c-94c0-eebf11da387e")
	)
	(text "3.3 Vpp DAC -> 33 mVpp at MIC_IN, AC coupled.\nUsed for DTMF / tone signalling over the radio."
		(exclude_from_sim no)
		(at 14 177 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fee4e752-76d1-4cca-97c9-67d21fd9a8cb")
	)
	(text "RADIO AF_OUT -> ADC1 (software Goertzel DTMF decoder)"
		(exclude_from_sim no)
		(at 159.5 114 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ad260112-0d50-49bd-9382-a5241bb2ae32")
	)
	(text "AF_OUT is 700 mV / 200 ohm: R507 with the 50k bias gives about 0.35 Vrms swing around 1.65 V at GPIO36.\nR510/C510 = 16 kHz anti-alias for a 40 kHz ADC sample rate."
		(exclude_from_sim no)
		(at 160 177 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "459f6261-df66-44b1-8049-0939822425b7")
	)
