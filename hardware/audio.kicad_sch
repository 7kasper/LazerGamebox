	(text "AUDIO: DAC or radio audio -> class-D amp -> speaker; DAC -> radio mic; radio audio -> ADC for DTMF"
		(exclude_from_sim no)
		(at 14 13.2 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "64d279a3-3ef2-4d8c-b43e-00c02778334a")
	)
	(text "NS4150B gain = 2 x 240k / 220k = 2.2. MUX_SEL low = ESP32 DAC to the speaker, high = radio receive audio to the speaker."
		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fbb4e6a8-afbb-4691-9ff9-61a053df3b84")
	)
	(text "SOURCE SELECT (TS5A3159)"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7ebe8c65-a9fa-4206-a581-0800b520cce0")
	)
	(text "DAC1 is 0-3.3 V unipolar; R501 limits current into the switch.\nAC coupling after the switch (C501)."
		(exclude_from_sim no)
		(at 14 92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0e76af5d-fdee-46c5-b7f6-039c96352211")
	)
	(text "CLASS-D AMPLIFIER (NS4150B) + 30 mm SPEAKER"
		(exclude_from_sim no)
		(at 159.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5d4a4d91-1d30-413f-b85e-3e3828ed6130")
	)
	(text "R504 keeps the amp off until firmware drives AMP_SD high; R511 limits the current into CTRL while VBAT_SW is off.\nFirmware: AUX_EN high a few ms before AMP_SD high, AMP_SD low before AUX_EN low."
		(exclude_from_sim no)
		(at 250 76 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "02054cae-68d7-435f-9685-dcda51cb139b")
	)
	(text "Filter-free BTL output: keep speaker traces short and away from the radio. VCC on VBAT_SW with 470 uF bulk.\nMax output about 1 W into 8 ohm at 3.7 V."
		(exclude_from_sim no)
		(at 160 97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e39a65e0-88ab-4590-a719-97aef08d2224")
	)
	(text "DAC -> RADIO MIC_IN (100:1)"
		(exclude_from_sim no)
		(at 13.5 114 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c15a3cf9-fcf3-4367-9e46-bd95a839e9f0")
	)
	(text "3.3 Vpp DAC -> 33 mVpp at MIC_IN, AC coupled.\nUsed for DTMF / tone signalling over the radio."
		(exclude_from_sim no)
		(at 14 177 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "24743a88-c74a-4942-87a9-ed7cb24e3e46")
	)
	(text "RADIO AF_OUT -> ADC1 (software Goertzel DTMF decoder)"
		(exclude_from_sim no)
		(at 159.5 114 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ecdbfd39-5010-4830-8dd7-2881c25f0216")
	)
	(text "AF_OUT is 700 mV / 200 ohm: R507 with the 50k bias gives about 0.35 Vrms swing around 1.65 V at GPIO36.\nR510/C510 = 16 kHz anti-alias for a 40 kHz ADC sample rate."
		(exclude_from_sim no)
		(at 160 177 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "051bf31d-1196-4f7b-b560-1b46efa02fdd")
	)
