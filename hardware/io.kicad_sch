	)
	(text "EXP0-9: 3.3 V GPIO, 10 mA sink, 25 mA source,\nno PWM, about 1 ms latency.\nOUT1/OUT2: open drain to GND, 2 A each; loads\nreturn to VBAT_SW or +3V3. Gates pulled down,\noff until firmware enables them.\nI2C on the header for more gadgets."
		(exclude_from_sim no)
		(at 278 222 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "1e6f1b85-29f1-4b34-9606-46be1499f0e7")
	)
	(text "IR: 38 kHz RECEIVER and 940 nm HIGH-POWER EMITTER (laser-tag style)"
		(exclude_from_sim no)
		(at 13.5 134 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "29e3c01c-d78f-4549-9ebd-5614175a51d9")
	)
	(text "Receiver on LCD_3V3 (1.2 mA), output pulled up to 3.3 V -> GPIO35 (RMT). Never power it from VBAT_SW: its output would exceed 3.3 V.\nEmitter: about 150-230 mA peak at 38 kHz / 50 % duty from VBAT_SW through 12 R (1206). Keep bursts under 100 ms."
		(exclude_from_sim no)
		(at 14 203 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d4e722c5-f2d1-48fc-af80-06f0f9060b00")
	)
