	(text "LoRa 868 MHz (Ra-01SH), GNSS (ATGM336H-5N31), optional cellular (SIM7080G, all DNP)"
		(exclude_from_sim no)
		(at 14 13.2 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ef5a7c8f-7bae-4c5d-bb14-6e9d1a45e9f3")
	)
	(text "LoRa on VSPI with its own CS. GPS on UART1 behind GPS_3V3. Cellular shares UART1 through 0R links and needs 1.8 V level shifting."
		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "606451f5-7fbd-460c-b429-5643c5df6665")
	)
	(text "LoRa Ra-01SH (SX1262)"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "459a77f1-828b-4154-93dc-b1ffa3ae50ba")
	)
	(text "RF switch is driven by DIO2 inside the module: setDio2AsRfSwitch(true). TXEN/RXEN pads unused.\nSX1262 sleep 1 uA, always powered from +3V3. 50 ohm trace to the spring antenna, keep 15 mm from the UHF PA."
		(exclude_from_sim no)
		(at 14 116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "17a39591-63de-4c71-8ce6-cb5952f82021")
	)
	(text "GNSS ATGM336H-5N31 (UART1, 1PPS)"
		(exclude_from_sim no)
		(at 13.5 139 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f86224ab-e2f8-4945-bf45-64af9643914a")
	)
	(text "Passive patch antenna on a solid ground pour (40 x 40 mm), 15 mm or more from the UHF PA and the LoRa antenna.\nVBAT backup pin on +3V3 (10 uA) keeps ephemeris for hot starts while GPS_3V3 is switched off. ON/OFF pulled up by R410."
		(exclude_from_sim no)
		(at 14 236 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e77b49ea-ebf4-4c62-9565-1944af31ff6c")
	)
	(text "CELLULAR OPTION: SIM7080G Cat-M / NB-IoT + nano-SIM + antenna (ALL DNP)"
		(exclude_from_sim no)
		(at 214.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7a47fa46-e8bb-4df6-84a0-f4a6e6c2e501")
	)
	(text "Fit EITHER the GNSS module OR the cellular module (SIM7080G has its own GNSS): both share UART1 via R406/R409.\nSIM7080G IO is 1.8 V (VDD_EXT): Q402/Q403 are BSS138-style bidirectional level shifters.\nPWRKEY pulsed low 1 s by CELL_PWRKEY through Q401. No ESD array on the SIM lines: socket sits inside the enclosure."
		(exclude_from_sim no)
		(at 215 232 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "828b6a84-194e-45ab-ba98-2430e57331cf")
	)
