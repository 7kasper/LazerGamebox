	(text "MCU: ESP32-WROOM-32E, USB serial (CH340C on its own 3.3 V LDO), accelerometer, I2C GPIO expander"
		(exclude_from_sim no)
		(at 14 13.2 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "bf4d5362-0114-4d3d-8905-c1c54c2c1aa1")
	)
	(text "All 26 usable GPIO are used; slow enables, resets and buttons live on the TCA9555 (I2C 0x20). See docs/pinmap.md."
		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "52c24462-3632-417e-bd74-2cf087015c49")
	)
	(text "ESP32-WROOM-32E-N16 (16 MB flash)"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "17be0acc-3d41-4889-8e0a-5f2526de613b")
	)
	(text "BOOT / RESET BUTTONS"
		(exclude_from_sim no)
		(at 13.5 213 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2df9822a-26cd-4ce4-9e92-58b38bf09ca6")
	)
	(text "IO0 low at reset = download mode. RESET pulls EN low.\nStrapping: IO2 has a 10k pull-down (R203, net LCD_BL),\nIO12 has no pull-up (flash stays 3.3 V),\nIO5 and IO15 keep their internal pull-ups."
		(exclude_from_sim no)
		(at 75 226 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1ecca768-4b11-471c-b83c-8d00b51516c5")
	)
	(text "USB SERIAL: CH340C + auto-reset"
		(exclude_from_sim no)
		(at 184.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2f820695-afb2-4227-ab64-9f65a8096ada")
	)
	(text "CH340C runs from its own 3.3 V LDO on VBUS (V3 tied to VCC): 3.3 V logic into the ESP32,\nunpowered on battery. DTR/RTS transistor pair = esptool auto-reset."
		(exclude_from_sim no)
		(at 185 116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d349761a-dc3e-434c-b91f-5a9cc1c835ec")
	)
	(text "ACCELEROMETER (LIS3DHTR, I2C 0x18)"
		(exclude_from_sim no)
		(at 184.5 133 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4ee0245a-19e7-4b04-8ca3-0f26c7c878aa")
	)
	(text "SA0 (SDO) pulled low by R209 = address 0x18, CS high = I2C mode. INT1 wakes the ESP32 via the expander INT."
		(exclude_from_sim no)
		(at 185 196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6734637a-6029-4d6f-a6aa-0f1ad7744876")
	)
	(text "I2C GPIO EXPANDER (TCA9555, 0x20)"
		(exclude_from_sim no)
		(at 319.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5e0b8134-25e1-4b10-b08a-89334093fe74")
	)
	(text "P00-P11 outputs, P12-P17 inputs\n(100k internal pull-ups).\nINT open drain -> GPIO32,\next0 wake source."
		(exclude_from_sim no)
		(at 320 236 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d8a3c0e4-dbcf-434f-9a9b-7b425da60c80")
	)
