	(text "MCU: ESP32-WROOM-32E, USB serial (CH340C on its own 3.3 V LDO), accelerometer, I2C GPIO expander"
		(exclude_from_sim no)
		(at 14 13.2 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f4703a6c-27cd-4cb2-8f1a-3bafb4a9a860")
	)
	(text "All 26 usable GPIO are used; slow enables, resets and buttons live on the TCA9555 (I2C 0x20). See docs/pinmap.md."
		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "16e79cb1-25b7-485c-bd2c-3dd6ab5f80d4")
	)
	(text "ESP32-WROOM-32E-N16 (16 MB flash)"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0d4527c5-c2a0-4e44-bca9-994f39c54d02")
	)
	(text "BOOT / RESET BUTTONS"
		(exclude_from_sim no)
		(at 13.5 213 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f46acf30-888d-4be9-b1ff-8b3ff8d63d24")
	)
	(text "IO0 low at reset = download mode. RESET pulls EN low.\nStrapping: IO2 has a 10k pull-down (R203, net LCD_BL),\nIO12 has no pull-up (flash stays 3.3 V),\nIO5 and IO15 keep their internal pull-ups."
		(exclude_from_sim no)
		(at 75 226 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "abf8edd6-7236-4dbd-bb66-0655be8bf5c7")
	)
	(text "USB SERIAL: CH340C + auto-reset"
		(exclude_from_sim no)
		(at 184.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0e891c0d-1d06-4fbb-a56b-3ab020ddb6a2")
	)
	(text "CH340C runs from its own 3.3 V LDO on VBUS (V3 tied to VCC): 3.3 V logic into the ESP32,\nunpowered on battery. DTR/RTS transistor pair = esptool auto-reset."
		(exclude_from_sim no)
		(at 185 116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "dfd306ab-ab3f-4d2a-b463-e7a92ea369c9")
	)
	(text "ACCELEROMETER (LIS3DHTR, I2C 0x18)"
		(exclude_from_sim no)
		(at 184.5 133 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5ee5478f-b034-449d-92ae-a8f6f9f23a00")
	)
	(text "SA0 (SDO) pulled low by R209 = address 0x18, CS high = I2C mode. INT1 wakes the ESP32 via the expander INT."
		(exclude_from_sim no)
		(at 185 196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7cbdd913-adec-4d27-b9ee-cc19d0a61068")
	)
	(text "I2C GPIO EXPANDER (TCA9555, 0x20)"
		(exclude_from_sim no)
		(at 319.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a77ff1f8-e96d-4377-afbd-c672a812b366")
	)
	(text "P00-P11 outputs, P12-P17 inputs\n(100k internal pull-ups).\nINT open drain -> GPIO32,\next0 wake source."
		(exclude_from_sim no)
		(at 320 236 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bff08b2c-1cc8-459e-928a-b16fe8dfcaab")
	)
