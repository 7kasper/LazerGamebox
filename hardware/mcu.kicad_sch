	(text "MCU: ESP32-WROOM-32E, USB serial (CH340C on its own 3.3 V LDO), accelerometer, I2C GPIO expander"
		(exclude_from_sim no)
		(at 14 13.2 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "41fc5b69-16d6-4e97-a57c-03dee178630a")
	)
	(text "All 26 usable GPIO are used; slow enables, resets and buttons live on the TCA9555 (I2C 0x20). See docs/pinmap.md."
		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "717a0da6-c03b-4b50-b8ac-12dfc525af99")
	)
	(text "ESP32-WROOM-32E-N16 (16 MB flash)"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "cef014bf-2cf4-4e8a-af4d-d43adbb5aff8")
	)
	(text "BOOT / RESET BUTTONS"
		(exclude_from_sim no)
		(at 13.5 213 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f1c9d27d-0222-4159-967f-053ae54baa77")
	)
	(text "IO0 low at reset = download mode. RESET pulls EN low.\nStrapping: IO2 has a 10k pull-down (R203, net LCD_BL),\nIO12 has no pull-up (flash stays 3.3 V),\nIO5 and IO15 keep their internal pull-ups."
		(exclude_from_sim no)
		(at 75 226 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ed75a2f-5423-4e75-bd72-04ffb7546d83")
	)
	(text "USB SERIAL: CH340C + auto-reset"
		(exclude_from_sim no)
		(at 184.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f264e336-791b-4fa6-a737-2bfaa19c478b")
	)
	(text "CH340C runs from its own 3.3 V LDO on VBUS (V3 tied to VCC): 3.3 V logic into the ESP32,\nunpowered on battery. DTR/RTS transistor pair = esptool auto-reset."
		(exclude_from_sim no)
		(at 185 116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cc9bd215-dc4c-4e1a-9ed4-6a3031ab8c6f")
	)
	(text "ACCELEROMETER (LIS3DHTR, I2C 0x18)"
		(exclude_from_sim no)
		(at 184.5 133 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "df640f31-5a7c-4eb8-9c49-26b89e91afb6")
	)
	(text "SA0 (SDO) pulled low by R209 = address 0x18, CS high = I2C mode. INT1 wakes the ESP32 via the expander INT."
		(exclude_from_sim no)
		(at 185 196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "83c4c767-c7ff-4224-b089-f37a95373e78")
	)
	(text "I2C GPIO EXPANDER (TCA9555, 0x20)"
		(exclude_from_sim no)
		(at 319.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4f063f99-a27a-401a-90b4-bd9c0d77c932")
	)
	(text "P00-P11 outputs, P12-P17 inputs\n(100k internal pull-ups).\nINT open drain -> GPIO32,\next0 wake source."
		(exclude_from_sim no)
		(at 320 236 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "03137209-8b84-4400-ba36-9291c327d8e4")
	)
