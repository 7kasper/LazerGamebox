	(text "POWER: USB-C PD sink, BQ25601 charger with power path, 2x 18650, fuel gauge, 3V3 buck, radio boost, load switches"
		(exclude_from_sim no)
		(at 14 13.2 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5830d756-d1a7-4138-ab4f-c1be09e62f2d")
	)
	(text "All switched rails default OFF at power-up (gate pull-downs); firmware enables them through the TCA9555 expander."
		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d857df99-874b-4b0b-adbb-1460219c16bc")
	)
	(text "USB-C INPUT"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "cd3c5eae-7776-498c-9e43-bcfdb6a11a7a")
	)
	(text "CC1/CC2 go to the HUSB238 PD sink (Rd inside it). D+/D- both rows joined (reversible plug).\nVBUS: 5 V only, up to 3 A negotiated; USBLC6 clamps VBUS and the data lines."
		(exclude_from_sim no)
		(at 14 100 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "acdff562-e21d-4b0e-8ba3-dd1a3a30cec2")
	)
	(text "CHARGER + POWER PATH (BQ25601, 2 A, I2C 0x6B)"
		(exclude_from_sim no)
		(at 131.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f6cc2742-c275-4dc2-b5a3-365757c6ce3a")
	)
	(text "NVDC power path: VSYS runs from USB or the cells; BATFET ship mode = true off.\nPlug-in defaults: 500 mA input (PSEL high), 2 A charge, 4.208 V. Firmware raises\nIINDPM after reading the HUSB238, clears EN_HIZ after a QON wake, feeds or\ndisables the 40 s watchdog."
		(exclude_from_sim no)
		(at 132 166 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "338be849-c401-4011-a7bd-0ebf12805c7b")
	)
	(text "2x 18650 IN PARALLEL + PROTECTION (DW01A + FS8205A)"
		(exclude_from_sim no)
		(at 13.5 119 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f68bfa49-956e-44cc-960d-20d3881c3c7f")
	)
	(text "Two cells of the same type and age, fitted together (parallel pair, no balancing needed).\nCell negative reaches system GND through the dual MOSFET (BAT- net).\nDW01A: 2.5 V under-voltage, 4.3 V over-voltage,\n150 mV over-current sense (2 to 4 A with the FS8205A)."
		(exclude_from_sim no)
		(at 14 244 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a65e5ba9-b104-4efc-aafc-d237b90b5b9b")
	)
	(text "PD SINK (HUSB238 0x08) + GAUGE (MAX17048 0x36)"
		(exclude_from_sim no)
		(at 131.5 189 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "75d0df72-1974-40fd-976e-5ffe297dcd58")
	)
	(text "HUSB238 runs from VBUS only; firmware reads its 5 V current capability and sets IINDPM.\nGauge on the cell pair; ALRT and /INT share PWR_INT (P17), firmware clears both."
		(exclude_from_sim no)
		(at 132 268 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "790ec2dd-6dbf-4976-9776-e48aa9de1f33")
	)
	(text "3V3 BUCK, ALWAYS ON (TPS62A02, 2 A, Iq 23 uA)"
		(exclude_from_sim no)
		(at 241.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "54788981-4498-425a-894c-62b3c985a58d")
	)
	(text "VOUT = 0.6 V x (1 + 100k/22k) = 3.33 V. L = 1 uH (SWPA4030S1R0, 5.7 A sat). fsw 2.4 MHz.\nEN tied to VIN: rail is always on; deep-sleep current is set by the ESP32 and the buck Iq."
		(exclude_from_sim no)
		(at 242 91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b31ab0ba-35a2-4e54-a307-c721b3e85f9f")
	)
	(text "RADIO SUPPLY: 4.6 V BOOST WITH TRUE DISCONNECT (TPS61023)"
		(exclude_from_sim no)
		(at 241.5 107 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "65c7d80e-cb02-4cb4-b639-c3f72e035820")
	)
	(text "VOUT = 0.6 V x (1 + 220k/33k) = 4.6 V. Pass-through when the cell is above 4.6 V.\nEN low = output disconnected (< 1 uA): no separate load switch for the radio. 470 uF bulk sits at the module (radio sheet)."
		(exclude_from_sim no)
		(at 242 178.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bb19baf5-8f5a-46ff-946e-d977c2919d45")
	)
	(text "LOAD SWITCHES (P-FET high side, N-FET level shift, default OFF)"
		(exclude_from_sim no)
		(at 241.5 189 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "cd984576-b196-4a50-aa7f-5bf51bbb5145")
	)
	(text "GPS_3V3: GNSS module.  LCD_3V3: display, pot, IR receiver.\nVBAT_SW: audio amp (470 uF bulk, hence the soft start), RGB LEDs, IR LED, backlight."
		(exclude_from_sim no)
		(at 242 244 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8891be3a-cd65-4262-892a-aaf77c4aa693")
	)
	(text "PWR_FLAG on GND (ERC only)."
		(exclude_from_sim no)
		(at 256 264.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "5f99d14f-6202-41b4-95c5-b07e43d2732c")
	)
