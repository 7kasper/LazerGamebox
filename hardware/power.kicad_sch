	(text "POWER: USB-C PD sink, BQ25601 charger with power path, 2x 18650, fuel gauge, 3V3 buck, radio boost, load switches"
		(exclude_from_sim no)
		(at 14 13.2 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7266df0f-73fe-48fa-88e1-6bf37cbcddd1")
	)
	(text "All switched rails default OFF at power-up (gate pull-downs); firmware enables them through the TCA9555 expander."
		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "db76b42d-1ed3-40e2-9a0c-a4d1667eb4e1")
	)
	(text "USB-C INPUT"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f95fe5c3-c9f4-4dc1-bf1e-a11e5b3d6d3a")
	)
	(text "CC1/CC2 go to the HUSB238 PD sink (Rd inside it). D+/D- both rows joined (reversible plug).\nVBUS: 5 V only, up to 3 A negotiated; USBLC6 clamps VBUS and the data lines."
		(exclude_from_sim no)
		(at 14 100 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "41cc187b-9660-4c86-88d5-8d4834fece9b")
	)
	(text "CHARGER + POWER PATH (BQ25601, 2 A, I2C 0x6B)"
		(exclude_from_sim no)
		(at 131.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ca0182c4-7b48-4951-aadb-46c883afa5f5")
	)
	(text "NVDC power path: VSYS runs from USB or the cells; BATFET ship mode = true off.\nPlug-in defaults: 500 mA input (PSEL high), 2 A charge, 4.208 V. Firmware raises\nIINDPM after reading the HUSB238, clears EN_HIZ after a QON wake, feeds or\ndisables the 40 s watchdog."
		(exclude_from_sim no)
		(at 132 166 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "e4a45089-091d-4be3-966d-b257905cd1f5")
	)
	(text "2x 18650 IN PARALLEL + PROTECTION (DW01A + FS8205A)"
		(exclude_from_sim no)
		(at 13.5 119 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "31454fce-58f7-4ab2-b53e-1de80cb7f18b")
	)
	(text "Two cells of the same type and age, fitted together (parallel pair, no balancing needed).\nCell negative reaches system GND through the dual MOSFET (BAT- net).\nDW01A: 2.5 V under-voltage, 4.3 V over-voltage,\n150 mV over-current sense (2 to 4 A with the FS8205A)."
		(exclude_from_sim no)
		(at 14 244 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "80da2206-095f-4416-9de3-de4e5ef444a1")
	)
	(text "PD SINK (HUSB238 0x08) + GAUGE (MAX17048 0x36)"
		(exclude_from_sim no)
		(at 131.5 189 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "296ee515-5e2c-4d2b-88fe-64fa1cbb5ea5")
	)
	(text "HUSB238 runs from VBUS only; firmware reads its 5 V current capability and sets IINDPM.\nGauge on the cell pair; ALRT and /INT share PWR_INT (P17), firmware clears both."
		(exclude_from_sim no)
		(at 132 268 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "aaf7eb12-6adc-47b2-8610-e248b6a2fedc")
	)
	(text "3V3 BUCK, ALWAYS ON (TPS62A02, 2 A, Iq 23 uA)"
		(exclude_from_sim no)
		(at 241.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "50311cc0-1aaa-44fb-85a0-ed6978aed3d6")
	)
	(text "VOUT = 0.6 V x (1 + 100k/22k) = 3.33 V. L = 1 uH (SWPA4030S1R0, 5.7 A sat). fsw 2.4 MHz.\nEN tied to VIN: rail is always on; deep-sleep current is set by the ESP32 and the buck Iq."
		(exclude_from_sim no)
		(at 242 91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "beb750a6-340f-401c-a9f5-42f348070d2d")
	)
	(text "RADIO SUPPLY: 4.6 V BOOST WITH TRUE DISCONNECT (TPS61023)"
		(exclude_from_sim no)
		(at 241.5 107 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b026304e-3fd3-41f6-af96-ca6a170a28d8")
	)
	(text "VOUT = 0.6 V x (1 + 220k/33k) = 4.6 V. Pass-through when the cell is above 4.6 V.\nEN low = output disconnected (< 1 uA): no separate load switch for the radio. 470 uF bulk sits at the module (radio sheet)."
		(exclude_from_sim no)
		(at 242 178.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a5cb1fa8-62eb-4364-a0cc-89ae362e604b")
	)
	(text "LOAD SWITCHES (P-FET high side, N-FET level shift, default OFF)"
		(exclude_from_sim no)
		(at 241.5 189 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "09622e83-925e-4717-ba10-4ef3f30f7d63")
	)
	(text "GPS_3V3: GNSS module.  LCD_3V3: display, pot, IR receiver.\nVBAT_SW: audio amp (470 uF bulk, hence the soft start), RGB LEDs, IR LED, backlight."
		(exclude_from_sim no)
		(at 242 244 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1fa034ec-1a52-4a28-b4d1-85ad6212bf61")
	)
	(text "PWR_FLAG on GND (ERC only)."
		(exclude_from_sim no)
		(at 256 264.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "35b026f4-67d2-41a2-87cf-2da89d407c6a")
	)
