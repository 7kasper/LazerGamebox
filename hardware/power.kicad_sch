	(text "POWER: USB-C PD sink, BQ25601 charger with power path, 2x 18650, fuel gauge, 3V3 buck, radio boost, load switches"
		(exclude_from_sim no)
		(at 14 13.2 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d4241da7-215b-44c5-bae3-0c4f3c154c79")
	)
	(text "All switched rails default OFF at power-up (gate pull-downs); firmware enables them through the TCA9555 expander."
		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6aaf5d7f-8425-474b-b34a-0dce522685e8")
	)
	(text "USB-C INPUT"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9470976c-fd71-45b7-9f00-e2e7ee206660")
	)
	(text "CC1/CC2 go to the HUSB238 PD sink (Rd inside it). D+/D- both rows joined (reversible plug).\nVBUS: 5 V only, up to 3 A negotiated; USBLC6 clamps VBUS and the data lines."
		(exclude_from_sim no)
		(at 14 100 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6563368c-01aa-4373-af31-b60fb48be024")
	)
	(text "CHARGER + POWER PATH (BQ25601, 2 A, I2C 0x6B)"
		(exclude_from_sim no)
		(at 131.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "193e582a-8510-4542-aa7b-373407ffd7c3")
	)
	(text "NVDC power path: VSYS runs from USB or the cells; BATFET ship mode = true off.\nPlug-in defaults: 500 mA input (PSEL high), 2 A charge, 4.208 V. Firmware raises\nIINDPM after reading the HUSB238, clears EN_HIZ after a QON wake, feeds or\ndisables the 40 s watchdog."
		(exclude_from_sim no)
		(at 132 166 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "c7401aca-d596-42a9-b377-f35e078ec867")
	)
	(text "2x 18650 IN PARALLEL + PROTECTION (DW01A + FS8205A)"
		(exclude_from_sim no)
		(at 13.5 119 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "37881ec1-3447-4981-a850-1bfb73613e44")
	)
	(text "Two cells of the same type and age, fitted together (parallel pair, no balancing needed).\nCell negative reaches system GND through the dual MOSFET (BAT- net).\nDW01A: 2.5 V under-voltage, 4.3 V over-voltage,\n150 mV over-current sense (2 to 4 A with the FS8205A)."
		(exclude_from_sim no)
		(at 14 244 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b189f879-5630-4238-885c-cf64dd0fca75")
	)
	(text "PD SINK (HUSB238 0x08) + GAUGE (MAX17048 0x36)"
		(exclude_from_sim no)
		(at 131.5 189 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "67d70021-e34d-4d79-976e-e64dc1c3b624")
	)
	(text "HUSB238 runs from VBUS only; firmware reads its 5 V current capability and sets IINDPM.\nGauge on the cell pair; ALRT and /INT share PWR_INT (P17), firmware clears both."
		(exclude_from_sim no)
		(at 132 268 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "90c2abbe-22fb-46ef-82d0-3a5f8c8f1f78")
	)
	(text "3V3 BUCK, ALWAYS ON (TPS62A02, 2 A, Iq 23 uA)"
		(exclude_from_sim no)
		(at 241.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "13c99988-1f0f-4874-9c5c-d86ae9341390")
	)
	(text "VOUT = 0.6 V x (1 + 100k/22k) = 3.33 V. L = 1 uH (SWPA4030S1R0, 5.7 A sat). fsw 2.4 MHz.\nEN tied to VIN: rail is always on; deep-sleep current is set by the ESP32 and the buck Iq."
		(exclude_from_sim no)
		(at 242 91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f69965db-f799-4de3-81c3-c96c142e8dc1")
	)
	(text "RADIO SUPPLY: 4.6 V BOOST WITH TRUE DISCONNECT (TPS61023)"
		(exclude_from_sim no)
		(at 241.5 107 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6c2b5732-6d33-43e4-8558-c4f444183844")
	)
	(text "VOUT = 0.6 V x (1 + 220k/33k) = 4.6 V. Pass-through when the cell is above 4.6 V.\nEN low = output disconnected (< 1 uA): no separate load switch for the radio. 470 uF bulk sits at the module (radio sheet)."
		(exclude_from_sim no)
		(at 242 178.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "43f15d18-5818-48da-bed5-7cdd1eee22c5")
	)
	(text "LOAD SWITCHES (P-FET high side, N-FET level shift, default OFF)"
		(exclude_from_sim no)
		(at 241.5 189 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9f861f2e-7bf5-4618-87fa-c36dca605f49")
	)
	(text "GPS_3V3: GNSS module.  LCD_3V3: display, pot, IR receiver.\nVBAT_SW: audio amp (470 uF bulk, hence the soft start), RGB LEDs, IR LED, backlight."
		(exclude_from_sim no)
		(at 242 244 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "953046da-f09b-400a-aa55-7783cb8cebb4")
	)
	(text "PWR_FLAG on GND (ERC only)."
		(exclude_from_sim no)
		(at 256 264.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "7d2e5882-4b17-4070-a8fc-570537ca89c8")
	)
