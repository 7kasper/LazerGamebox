		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9429908f-264a-4266-80cd-a08e99c23a2b")
	)
	(text "SA818S-U MODULE"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d465265b-3c42-4261-b5ad-f86890ecf872")
	)
	(text "50 ohm coplanar trace, ground stitching both sides.\nPi pads C301/R301/C302 for matching (fit 0R only).\nWhip antenna screwed on by hand after assembly."
		(exclude_from_sim no)
		(at 150 66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c04668dc-47eb-4082-a75b-85a75a27f19b")
	)
	(text "Module current: RX 60 mA, TX high 750 mA, TX low 450 mA, 1 uA in power-down. 470 uF right at the VBAT pad.\nH/L open = 1 W; bridge JP301 for 0.5 W (the pin must never be driven high)."
		(exclude_from_sim no)
		(at 14 106 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c2224ab0-6122-48d1-a6a7-6cf0b3dc17d2")
	)
	(text "MODULE CONTROL"
		(exclude_from_sim no)
		(at 13.5 127 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "232a0ebc-e66f-4073-8eb5-452917d2780b")
	)
	(text "PD held high (3.2 V) whenever the boost is on."
		(exclude_from_sim no)
		(at 20 182 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "2015eb03-0758-4240-a1da-fa663c1de16c")
	)
	(text "RADIO_PTT (GPIO27) high = transmit. Open drain: no current into the module when it is off.\nR305 pulls PTT to the PD node (3.2 V, follows the boost rail): RX by default, nothing back-drives a dead module."
		(exclude_from_sim no)
		(at 75 184 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "f7a9aac5-1508-451b-9369-0e282ddfe0ab")
	)
	(text "JP301 open: 1 W (default)."
		(exclude_from_sim no)
		(at 190 172 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "3724dc61-371a-48f8-9fcc-33408eb0927f")
	)
