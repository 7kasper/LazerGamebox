		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7581c3b3-e105-491f-8305-978921d2da99")
	)
	(text "SA818S-U MODULE"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d2b46410-e972-48e8-976d-6a8aa27e9c15")
	)
	(text "50 ohm coplanar trace, ground stitching both sides.\nPi pads C301/R301/C302 for matching (fit 0R only).\nWhip antenna screwed on by hand after assembly."
		(exclude_from_sim no)
		(at 150 66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "31804afb-766d-404f-92b4-cf011ae914de")
	)
	(text "Module current: RX 60 mA, TX high 750 mA, TX low 450 mA, 1 uA in power-down. 470 uF right at the VBAT pad.\nH/L open = 1 W; bridge JP301 for 0.5 W (the pin must never be driven high)."
		(exclude_from_sim no)
		(at 14 106 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0c11740f-42c7-4ef7-80b5-bea952aa3af1")
	)
	(text "MODULE CONTROL"
		(exclude_from_sim no)
		(at 13.5 127 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f238b6fa-768b-48a0-ae4f-c7210b64b9c4")
	)
	(text "PD held high (3.2 V) whenever the boost is on."
		(exclude_from_sim no)
		(at 20 182 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "2e1e62a8-75cb-4220-8430-20b44beea693")
	)
	(text "RADIO_PTT (GPIO27) high = transmit. Open drain: no current into the module when it is off.\nR305 pulls PTT to the PD node (3.2 V, follows the boost rail): RX by default, nothing back-drives a dead module."
		(exclude_from_sim no)
		(at 75 184 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "6e220d27-ad99-43f6-a6eb-ab9746fd05c1")
	)
	(text "JP301 open: 1 W (default)."
		(exclude_from_sim no)
		(at 190 172 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "b9157a8e-41b0-4614-8253-f81383f7e41b")
	)
