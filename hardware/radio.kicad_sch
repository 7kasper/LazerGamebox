		(exclude_from_sim no)
		(at 14 16.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6aaa3633-ff1e-4a32-9696-fcae809626c1")
	)
	(text "SA818S-U MODULE"
		(exclude_from_sim no)
		(at 13.5 21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "cb1956f9-2ed7-40ae-ba47-98aef85314e7")
	)
	(text "50 ohm coplanar trace, ground stitching both sides.\nPi pads C301/R301/C302 for matching (fit 0R only).\nWhip antenna screwed on by hand after assembly."
		(exclude_from_sim no)
		(at 150 66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "aa080084-98bb-4803-9c78-3424a3fa4427")
	)
	(text "Module current: RX 60 mA, TX high 750 mA, TX low 450 mA, 1 uA in power-down. 470 uF right at the VBAT pad.\nH/L open = 1 W; bridge JP301 for 0.5 W (the pin must never be driven high)."
		(exclude_from_sim no)
		(at 14 106 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "57e0a5ef-c0c2-4874-8d85-64748987f8ea")
	)
	(text "MODULE CONTROL"
		(exclude_from_sim no)
		(at 13.5 127 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9b437484-c4b2-4a59-8e06-0c4679a373f6")
	)
	(text "PD held high (3.2 V) whenever the boost is on."
		(exclude_from_sim no)
		(at 20 182 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "71d08e41-e512-468b-8ba4-dd9a67c38b92")
	)
	(text "RADIO_PTT (GPIO27) high = transmit. Open drain: no current into the module when it is off.\nR305 pulls PTT to the PD node (3.2 V, follows the boost rail): RX by default, nothing back-drives a dead module."
		(exclude_from_sim no)
		(at 75 184 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "3a8362f6-b7c9-453b-87ed-5065958aeeb8")
	)
	(text "JP301 open: 1 W (default)."
		(exclude_from_sim no)
		(at 190 172 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "bf13cd37-32e4-43ef-90a2-12e9f3899185")
	)
